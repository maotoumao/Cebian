# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.output
# pnpm 的本地 store（某些环境会落在仓库根，不该入库）
.pnpm-store/
stats.html
stats-*.json
.wxt
web-ext.config.ts
.worktrees/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
# Claude Code: shared config is committed, personal overrides are not
.claude/settings.local.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local environment overrides (may contain dev API keys, etc.)
# `.env` / `.env.example` are committed; `*.local` are personal overrides.
.env.local
.env.*.local

# Astro site build output / cache
site/.astro/
site/dist/

# Design mockup / visual draft (working artifacts, not the shipped site)
site/mockup/

# Private notes folder, never committed (root only — must NOT match site/src/content/docs/)
/docs/
