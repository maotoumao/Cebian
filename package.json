{
  "name": "Cebian",
  "description": "AI-powered browser extension for enhanced web browsing experience",
  "private": true,
  "version": "1.8.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "overrides": {
      "publish-browser-extension": "6.1.1"
    }
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node scripts/scan-obfuscation.mjs .output/chrome-mv3",
    "build:firefox": "wxt build -b firefox && node scripts/scan-obfuscation.mjs .output/firefox-mv2",
    "zip": "wxt zip && node scripts/scan-obfuscation.mjs .output/chrome-mv3",
    "zip:firefox": "wxt zip -b firefox && node scripts/scan-obfuscation.mjs .output/firefox-mv2",
    "compile": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "depcruise": "depcruise entrypoints components hooks lib --config .dependency-cruiser.cjs",
    "lint:agents": "node scripts/check-agent-config.mjs",
    "check": "node scripts/check-agent-config.mjs && wxt prepare && tsc --noEmit && node scripts/lint-i18n.mjs && vitest run",
    "postinstall": "wxt prepare && simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@earendil-works/pi-agent-core": "~1.1.0",
    "@earendil-works/pi-ai": "~1.1.0",
    "@isomorphic-git/lightning-fs": "^4.10.3",
    "@lezer/highlight": "^1.2.5",
    "@mcp-ui/client": "^7.1.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@mozilla/readability": "^0.6.0",
    "@wxt-dev/i18n": "^0.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "front-matter": "^4.0.2",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.50.0",
    "pdfjs-dist": "^6.3.289",
    "picomatch": "^4.0.7",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.27",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.8",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "dependency-cruiser": "^18.5.0",
    "fake-indexeddb": "^6.2.5",
    "shadcn": "^4.21.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
